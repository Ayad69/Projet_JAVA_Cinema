@startuml diagramme-activite-appli-cinema
title Diagramme d'activité — Application JavaFX Gestion cinéma

skinparam ActivityBackgroundColor #E8F4FC
skinparam ActivityBorderColor #2E6DA4
skinparam ActivityDiamondBackgroundColor #FFF8DC
skinparam ActivityStartColor #2E6DA4
skinparam ActivityEndColor #2E6DA4

|Utilisateur|
start
:Lance l'application;
:Saisit identifiant et mot de passe;
:Clic « Connexion »;

|Système|
:UtilisateurDAO.authenticate(login, mdp);

if (Identifiants valides ?) then (non)
  |Utilisateur|
  :Afficher « Login ou MDP incorrect »;
  stop
else (oui)
endif

|Système|
:Session.setUtilisateur(user);
:Fermer fenêtre connexion;
:Ouvrir écran Accueil;

|Utilisateur|
while (Session ouverte ?) is (oui)
  :Choisir une entrée du menu\n(franchises, cinémas, salles, accueil, quitter);

  if (Quitter ?) then (oui)
    |Système|
    :Session.clear();
    break
  else (non)
    |Système|
    if (Franchises : liste / ajout / modif ?) then (oui)
      :Charger FXML + FranchiseDAO;\nconsigner activité si applicable;
    elseif (Cinémas : liste / ajout / modif / voir plus ?) then (oui)
      :Charger FXML + CinemaDAO\n(+ SalleDAO au besoin);
    elseif (Salles : liste / ajout / modif ?) then (oui)
      :Charger FXML + SalleDAO;
    elseif (Accueil ?) then (oui)
      :Charger page_accueil.fxml;
    else (autre)
      :—;
    endif
    |Utilisateur|
    :Utiliser l'écran puis revenir au menu;
  endif

endwhile (non)

|Système|
:Platform.exit();

|Utilisateur|
stop

@enduml
