<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="478.0"
      prefWidth="804.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cinema.controllers.VoirPlusCinemaController">
    <children>
        <Label alignment="CENTER"
               contentDisplay="CENTER"
               layoutY="24.0"
               prefHeight="40.0"
               prefWidth="804.0"
               text="DÉTAILS DU CINÉMA"
               textAlignment="CENTER"
               textFill="#024010">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <VBox layoutX="60.0" layoutY="80.0" prefWidth="684.0" spacing="12.0">
            <children>
                <HBox spacing="10.0">
                    <children>
                        <Label prefWidth="160.0" text="Dénomination :" textFill="#024010">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lDenomination" text="—" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label prefWidth="160.0" text="Adresse :" textFill="#024010">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lAdresse" text="—" wrapText="true" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label prefWidth="160.0" text="Ville :" textFill="#024010">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lVille" text="—" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label prefWidth="160.0" text="Franchise :" textFill="#024010">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lFranchise" text="—" />
                    </children>
                </HBox>
                <Label text="Salles de ce cinéma :" textFill="#024010">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextArea fx:id="taSalles"
                          editable="false"
                          prefHeight="180.0"
                          prefWidth="684.0"
                          wrapText="true" />
            </children>
        </VBox>

        <HBox alignment="CENTER"
              layoutY="400.0"
              prefHeight="60.0"
              prefWidth="804.0"
              spacing="20.0">
            <children>
                <Button fx:id="bRetour"
                        mnemonicParsing="false"
                        onAction="#bRetourClick"
                        prefHeight="39.0"
                        prefWidth="200.0"
                        text="RETOUR"
                        textFill="#024010">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        <ImageView fitHeight="32.0" fitWidth="150.0" layoutX="640.0" layoutY="8.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/cineforall_logo.png" />
            </image>
        </ImageView>
    </children>
</Pane>
